{
  "manifest_version": 3,
  "name": "Lockin-Inator - Reels, Shorts & Focus Blocker",
  "version": "1.6.0",
  "description": "Full study lockouts for distracting sites (Instagram, YouTube, Reddit, TikTok, X) during study sessions; shields Reels & Shorts during breaks.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Lockin-Inator"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.reddit.com/*",
    "*://*.twitch.tv/*",
    "*://*.facebook.com/*",
    "*://*.netflix.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["css/youtube.css", "css/block_screen.css"],
      "js": ["scripts/sync_client.js", "scripts/youtube_blocker.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "css": ["css/instagram.css", "css/block_screen.css"],
      "js": ["scripts/sync_client.js", "scripts/instagram_blocker.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*",
        "*://*.twitch.tv/*",
        "*://*.facebook.com/*",
        "*://*.netflix.com/*"
      ],
      "css": ["css/block_screen.css"],
      "js": ["scripts/sync_client.js", "scripts/general_blocker.js"],
      "run_at": "document_start"
    }
  ]
}
